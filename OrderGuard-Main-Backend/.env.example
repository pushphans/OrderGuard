DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/order_guard
ACCESS_TOKEN_EXPIRY_IN_MINUTES=30
REFRESH_TOKEN_EXPIRY_IN_DAYS=7
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
ALGORITHM=HS256

# Shared with the AI microservice. Sent as the X-Service-Token header on
# internal (service-to-service) calls.
SERVICE_SECRET=CHANGE_ME_SHARED_SERVICE_SECRET
