# AI microservice's OWN database (cart + orders live here)
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/order_guard_ai

# Shared with the main backend so this service can DECODE its JWTs
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
ALGORITHM=HS256

# Base URL of the OrderGuard main backend (product reads + stock writes)
MAIN_BACKEND_URL=http://127.0.0.1:8000

# Shared service secret. Both services hold it. Sent as the
# X-Service-Token header on internal (service-to-service) calls.
SERVICE_SECRET=CHANGE_ME_SHARED_SERVICE_SECRET

# Groq key for the supervisor / agent LLMs
GROQ_API_KEY=
